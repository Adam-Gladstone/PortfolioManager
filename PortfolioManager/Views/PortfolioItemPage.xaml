<Page
    x:Class="PortfolioManager.Views.PortfolioItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PortfolioManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:PortfolioManager.Behaviors"
    xmlns:models="using:PortfolioManager.Core.Models"
    xmlns:viewmodels="using:PortfolioManager.ViewModels"
    xmlns:sys="using:System"
    mc:Ignorable="d">

    <!-- Setup page header (including the title) -->
    <behaviors:NavigationViewHeaderBehavior.HeaderTemplate>

        <DataTemplate x:DataType="viewmodels:PortfolioItemViewModel">

            <CommandBar
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Foreground="{ThemeResource ApplicationForegroundThemeBrush}">

                <CommandBar.Content>
                    <TextBlock Text="Portfolio Item" />
                </CommandBar.Content>

            </CommandBar>

        </DataTemplate>

    </behaviors:NavigationViewHeaderBehavior.HeaderTemplate>

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <SymbolIcon Margin="8" Symbol="Edit" />
            <TextBlock
                Margin="8"
                Style="{StaticResource SubheaderTextBlockStyle}"
                Text="Details" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Margin="4,0,4,8"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="0,1,0,1">

            <StackPanel Orientation="Vertical">

                <!--  Portfolio Name  -->
                <TextBox
                    x:Name="portfolioName"
                    Margin="0,15,0,15"
                    Header="Portfolio Name"
                    Text="{x:Bind Path=ViewModel.PortfolioItem.Name, Mode=TwoWay}"
                    TextChanged="PortfolioName_TextChanged" />

                <!--  Portfolio Type  -->
                <TextBox
                    x:Name="portfolioType"
                    Margin="0,15,0,15"
                    Header="Portfolio Type"
                    Text="{x:Bind Path=ViewModel.PortfolioItem.Type, Mode=TwoWay}"
                    TextChanged="PortfolioType_TextChanged" />

                <!--  Command bar for the transactions list  -->
                <CommandBar
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsOpen="False">

                    <AppBarButton
                        Click="ButtonAdd_Click"
                        IsCompact="False"
                        Label="Add Transaction">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE710;" />
                    </AppBarButton>

                    <AppBarButton
                        Command="{x:Bind ViewModel.ImportCommand}"
                        IsCompact="False"
                        Label="Import Transactions">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B6;" />
                    </AppBarButton>

                </CommandBar>

                <!--  Transactions List  -->
                <ListView
                    x:Name="ListViewTransactions"
                    Width="800"
                    Height="400"
                    HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    DoubleTapped="ListViewTransactions_DoubleTapped"
                    IsDoubleTapEnabled="True"
                    ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
                    SelectionChanged="ListViewTransactions_SelectionChanged"
                    SelectionMode="Single"
                    ShowsScrollingPlaceholders="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Transaction">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Transaction Date  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{ThemeResource BaseTextBlockStyle}"
                                    Text="{x:Bind Date}" />

                                <!--  Ticker  -->
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{ThemeResource BaseTextBlockStyle}"
                                    Text="{x:Bind Ticker}" />

                                <!--  Transaction Type (Buy/Sell)  -->
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{ThemeResource BaseTextBlockStyle}"
                                    Text="{x:Bind Type}" />

                                <!--  # Shares  -->
                                <TextBlock
                                    Grid.Column="3"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Shares}" />

                                <!--  Price  -->
                                <TextBlock
                                    Grid.Column="4"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Price}" />

                                <!--  Cost  -->
                                <TextBlock
                                    Grid.Column="5"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind CostString}" />

                            </Grid>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </StackPanel>

        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <!-- Save Button -->
            <Button
                x:Name="ButtonSave"
                Margin="8"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="Save" />

            <!-- Cancel Button -->
            <Button
                x:Name="ButtonCancel"
                Margin="8"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="Cancel" />
            
        </StackPanel>

    </Grid>
</Page>
