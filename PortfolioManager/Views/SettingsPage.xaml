<Page
    x:Class="PortfolioManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:PortfolioManager.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <!--  Main Grid  -->
    <Grid>

        <!--  Locate all the settings cards (and expanders) inside a ScrollViewer  -->
        <ScrollViewer>

            <StackPanel x:Name="ContentArea">

                <!--  Appearance and behaviour  -->
                <TextBlock
                    Margin="0,5,0,5"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Appearance &amp; behaviour" />

                <!--  App theme card  -->
                <controls:SettingsCard Description="Select which app theme to display" Header="App theme">

                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsCard.HeaderIcon>

                    <ComboBox
                        x:Name="themeMode"
                        AutomationProperties.AutomationId="themeModeComboBox"
                        SelectionChanged="ThemeMode_SelectionChanged">
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                    </ComboBox>

                </controls:SettingsCard>

                <!--  Database folder  -->
                <TextBlock
                    x:Uid="Settings_DatabaseFolder"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Database Folder" />

                <StackPanel Margin="{StaticResource XSmallTopMargin}" Orientation="Horizontal">

                    <AppBarButton
                        Command="{x:Bind ViewModel.SetDatabaseFolderCommand}"
                        Icon="Folder"
                        IsEnabled="True"
                        Label="Database Folder" />

                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.DatabaseFolder, Mode=OneWay}" />

                </StackPanel>

                <!--  Python library  -->
                <TextBlock
                    x:Uid="Settings_PythonLibrary"
                    Margin="0,5,0,5"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Python Library" />

                <StackPanel Margin="{StaticResource XSmallTopMargin}" Orientation="Horizontal">

                    <AppBarButton
                        Command="{x:Bind ViewModel.SetPythonLibraryCommand}"
                        Icon="OpenFile"
                        IsEnabled="True"
                        Label="Filename" />

                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.PythonLibrary, Mode=OneWay}" />

                </StackPanel>

                <!--  Python scripts folder  -->
                <TextBlock
                    x:Uid="Settings_ScriptFolder"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Python Scripts Folder" />

                <StackPanel Margin="{StaticResource XSmallTopMargin}" Orientation="Horizontal">

                    <AppBarButton
                        Command="{x:Bind ViewModel.SetScriptFolderCommand}"
                        Icon="Folder"
                        IsEnabled="True"
                        Label="Script Folder" />

                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.ScriptFolder, Mode=OneWay}" />

                </StackPanel>

                <!--  Portfolio Analysis Defaults  -->
                <TextBlock
                    Margin="0,5,0,5"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Portfolio Analysis Defaults" />

                <controls:SettingsExpander Description="Default settings for the portfolio analysis functionality" Header="Portfolio Analysis Defaults">

                    <!--  Icon  -->
                    <controls:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/PortfolioAnalysis.ico" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>

                        <!--  Default Risk Free Rate  -->
                        <controls:SettingsCard Description="The default risk free rate for the portfolio analysis." Header="Risk Free Rate">

                            <TextBox Text="{x:Bind ViewModel.RiskFreeRate, Mode=TwoWay}" />
                        
                        </controls:SettingsCard>

                        <!--  Default Benchmark Index  -->
                        <controls:SettingsCard Description="The default benchmark index to use for portfolio analysis." Header="Benchmark Index">

                            <TextBox Text="{x:Bind ViewModel.BenchmarkIndex, Mode=TwoWay}" />
                        
                        </controls:SettingsCard>                            

                        <!--  Default Start Date Offset  -->
                        <controls:SettingsCard Description="The default start date offset to use for portfolio analysis." Header="Start Date Offset">

                            <ComboBox
                                x:Name="defaultStartDateOffset"
                                AutomationProperties.AutomationId="defaultStartDateOffsetComboBox"
                                SelectionChanged="StartDateOffset_SelectionChanged">
                                <ComboBoxItem Content="1y" Tag="1" />
                                <ComboBoxItem Content="2y" Tag="2" />
                                <ComboBoxItem Content="3y" Tag="3" />
                                <ComboBoxItem Content="4y" Tag="4" />
                                <ComboBoxItem Content="5y" Tag="5" />
                            </ComboBox>

                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>

                </controls:SettingsExpander>

                <!--  Ticker Attributes Data  -->
                <TextBlock
                    x:Uid="Settings_TickerAttributes"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Ticker Attributes" />

                <StackPanel Margin="{StaticResource XSmallTopMargin}" Orientation="Horizontal">

                    <AppBarButton
                        Command="{x:Bind ViewModel.SetTickerAttributesCommand}"
                        Icon="Bullets"
                        IsEnabled="True"
                        Label="Ticker Attributes" />

                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.TickerAttributes, Mode=OneWay}" />

                </StackPanel>

                <!--  About  -->
                <TextBlock
                    Margin="0,5,0,5"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="About" />

                <controls:SettingsExpander Description="2025 Adam Gladstone." Header="Portfolio Manager">

                    <!--  Icon  -->
                    <controls:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/WindowIcon.ico" />
                    </controls:SettingsExpander.HeaderIcon>

                    <!--  Version  -->
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Version}" />

                    <controls:SettingsExpander.Items>

                        <!--  Clone settings card  -->
                        <controls:SettingsCard Header="To clone this repository">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="git clone https://github.com/Adam-Gladstone/PortfolioManager" />
                        </controls:SettingsCard>

                        <!--  Bug request settings card  -->
                        <controls:SettingsCard
                            x:Name="bugRequestCard"
                            Command="{x:Bind ViewModel.BugRequestCommand}"
                            Header="File a bug or request a new feature"
                            IsClickEnabled="True">
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </controls:SettingsCard.ActionIcon>
                        </controls:SettingsCard>

                        <!--  Dependencies settings card  -->
                        <controls:SettingsCard
                            HorizontalContentAlignment="Left"
                            ContentAlignment="Vertical"
                            Header="Dependencies &amp; references">
                            <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                <HyperlinkButton Content="{x:Bind WinAppSdkRuntimeDetails}" NavigateUri="https://aka.ms/windowsappsdk" />
                                <HyperlinkButton Content="Windows UI Library" NavigateUri="https://aka.ms/winui" />
                                <HyperlinkButton Content="Windows Community Toolkit" NavigateUri="https://github.com/CommunityToolkit/Windows" />
                                <HyperlinkButton Content="Application Icon" NavigateUri="https://icons8.com/icons" />
                            </StackPanel>
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>

                </controls:SettingsExpander>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>
